# NOTE: This file is OPTIONAL.
# You can configure everything directly from the Web UI at http://localhost:8080/#/settings
# Settings configured in the Web UI are encrypted and stored in SQLite, taking precedence over this file.

# Required — Groq API for taxonomy synthesis & large model tasks
SG_GROQ_API_KEY=your_groq_api_key_here
SG_GROQ_MODEL=llama-3.3-70b-versatile
# SG_GROQ_FALLBACK_MODELS=["meta-llama/llama-4-scout-17b-16e-instruct","qwen/qwen3-32b"]

# Optional — Local Model Server (vLLM, llama.cpp, Ollama, etc.)
SG_VLLM_BASE_URL=https://your-ngrok-url.ngrok.io
SG_VLLM_MODEL=Qwen/Qwen3.5-9B-FP8

# LinkedIn credentials (only required for live scraping / comment fetching)
SG_LINKEDIN_EMAIL=your@email.com
SG_LINKEDIN_PASSWORD=your_password_here
# OR Session Cookie (li_at):
# SG_LINKEDIN_COOKIE=your_li_at_cookie_here

# ─── Optional Overrides (defaults shown) ──────────────────────────────────────

# SG_DB_PATH=.socialgraph/socialgraph.db
# SG_WORKSPACE_DIR=.socialgraph
# SG_OBSIDIAN_VAULT_PATH=./vault
# SG_BATCH_SIZE=10
# SG_LLM_TIMEOUT=580.0
# SG_PLAYWRIGHT_HEADLESS=true
# SG_MAX_COMMENTS=50
# SG_LOG_LEVEL=INFO
# SG_WEB_PORT=8080
# SG_SCHEDULE_INTERVAL_HOURS=6.0
